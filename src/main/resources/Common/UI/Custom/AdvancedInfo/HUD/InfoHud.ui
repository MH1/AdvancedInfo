Group #AIHud {
  Padding: (Full: 10);
  Group #AIInner {
    Group #AIOffset {
      LayoutMode: Top;
      Group #AIContent {
        Background: (Color: #000000(0.6));
      }
      // Storage panel in the same column as the info panel (same alignment); stretches to its width.
      Group #AIStorageStacked {
        Visible: false;
        Background: (Color: #000000(0.6));
      }
    }
  }
}
// Storage panel with its own alignment.
Group #AISHud {
  Padding: (Full: 10);
  Group #AISInner {
    Group #AISOffset {
      Group #AIStorageSolo {
        Visible: false;
        Background: (Color: #000000(0.6));
      }
    }
  }
}
// Storage panel right above the crosshair: the two halves share the height, so the upper one ends
// at the screen centre and the panel sits at its bottom edge.
Group #AISMidHud {
  LayoutMode: Top;
  Padding: (Full: 10);
  Group #AISMidUpper {
    FlexWeight: 1;
    LayoutMode: Bottom;
    Group #AISMidInner {
      Group #AISMidOffset {
        Group #AIStorageMiddle {
          Visible: false;
          Background: (Color: #000000(0.6));
        }
      }
    }
  }
  Group #AISMidLower {
    FlexWeight: 1;
  }
}
